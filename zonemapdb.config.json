{
  "$schema": "node_modules/zonemapdb-cli/config.schema.json",
  "formatVersion": 0,
  "collection": "addresses",
  "input": {
    "path": "data/addresses/*.ndjson"
  },
  "schema": {
    "sortField": "key",
    "fields": {
      "key": {
        "kind": "string"
      },
      "number": {
        "kind": "string"
      },
      "street": {
        "kind": "string"
      },
      "state": {
        "kind": "string"
      },
      "city": {
        "kind": "string",
        "indexed": true,
        "absent": true
      },
      "unit": {
        "kind": "string",
        "absent": true
      },
      "postcode": {
        "kind": "string",
        "absent": true,
        "indexed": true
      }
    }
  },
  "compression": "gzip",
  "output": "public/blockdb",
  "clientOut": "src/blockdb"
}
